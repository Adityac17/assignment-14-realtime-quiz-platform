# Port the server listens on. Defaults to 5000 if unset.
# NOTE: on macOS, port 5000 is often taken by the AirPlay Receiver.
# If the server fails to boot, either disable AirPlay Receiver in
# System Settings > General > AirDrop & Handoff, or set a different port here.
PORT=5000

# (Optional) Override the per-question time limit in milliseconds.
# Defaults to 15000 (15 seconds). Mainly used by the integration test.
# QUIZ_TIME_LIMIT_MS=15000
